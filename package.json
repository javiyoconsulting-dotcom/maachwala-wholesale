{
  "name": "wholesellerservice",
  "version": "1.0.0",
  "private": true,
  "description": "Wholesale customer microservice",
  "main": "index.js",
  "scripts": {
    "start": "functions-framework --target=wholesellerService",
    "start:standalone": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:inspect": "node database/scripts/inspect-tenant-schema.js",
    "db:migrate-all": "node database/scripts/migrate-all-tenants.js",
    "db:provision": "node database/scripts/provision-tenant.js",
    "db:validate": "node database/scripts/validate-migrations.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.5",
    "@google-cloud/pubsub": "^5.3.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "json-bigint": "^1.0.0",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  }
}
